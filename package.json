{
  "name": "consulta-cep",
  "version": "1.0.0",
  "description": "Consulta de CEP (ViaCEP) em JavaScript puro, com testes Jest, lint e CI/CD no GitHub Actions",
  "main": "index.html",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint ."
  },
  "keywords": [
    "cep",
    "qualidade-software",
    "ci-cd",
    "testes"
  ],
  "author": "Thiago Cotrin & Iago",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/js/**/*.js",
      "!src/js/app.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ]
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Thiago-Cotrin/consulta-cep.git"
  },
  "homepage": "https://thiago-cotrin.github.io/consulta-cep/",
  "engines": {
    "node": ">=20"
  }
}
